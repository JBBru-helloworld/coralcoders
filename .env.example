# Canonical origin used in canonical tags, sitemap.xml, robots.txt, Open Graph
# and JSON-LD. Defaults to https://coralcoders.com when unset.
NEXT_PUBLIC_SITE_URL=https://coralcoders.com

# Cloudflare Web Analytics site token (Web Analytics > the site > Manage site >
# JS snippet: the value of "token" only). Leave empty to build without the
# analytics beacon, for example locally.
NEXT_PUBLIC_CF_BEACON_TOKEN=
