# Cloudflare Workers static assets: response headers. Copied into out/ by
# `next build`; not served itself.
#
# A request that matches several rules gets every rule's headers, and a header
# set twice is joined with a comma. So Cache-Control is set in exactly one rule
# per path, never under /*. Paths without a Cache-Control rule keep Cloudflare's
# default: public, max-age=0, must-revalidate.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'

# Content-hashed build output: scripts, fonts and media.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images with stable (unhashed) filenames: one day.
/coral/*
  Cache-Control: public, max-age=86400
/brand/*
  Cache-Control: public, max-age=86400
/images/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/icon.png
  Cache-Control: public, max-age=86400
/apple-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/courses/:slug/og.png
  Cache-Control: public, max-age=86400

# HTML and text files: always revalidated (the default, stated explicitly).
/
  Cache-Control: public, max-age=0, must-revalidate
/privacy/
  Cache-Control: public, max-age=0, must-revalidate
/courses/:slug/
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Cache-Control: public, max-age=0, must-revalidate
